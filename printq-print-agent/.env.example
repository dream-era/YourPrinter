# Copy this file to .env and fill in your values.

# Your PrintQ backend's base URL (no trailing slash)
API_BASE_URL=https://yourdomain.com

# The agent key shown ONCE when the owner registered this device via
# POST /api/shops/[shopId]/agents — looks like: pq_agent_<uuid>.<secret>
AGENT_KEY=

# How often to check for new print jobs, in milliseconds. 5-10s is
# reasonable for a manual "Start Print" flow; lower it if you later use
# this same agent for 24/7 unattended autoprint where latency matters more.
POLL_INTERVAL_MS=8000

# Optional: name of a specific printer to send jobs to (as it appears in
# your OS's printer list). Leave blank to use the system default printer.
PRINTER_NAME=

# Optional: path to the LibreOffice/soffice binary, needed to auto-print
# DOCX/PPTX files (they're converted to PDF first). Leave blank to use
# "soffice" from PATH. Common defaults:
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Mac:     /Applications/LibreOffice.app/Contents/MacOS/soffice
#   Linux:   usually just "soffice" if installed via package manager
LIBREOFFICE_PATH=
