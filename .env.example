# ==============================================================================
# MyPrinter — Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC VARIABLES (Safe to expose to browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YourPrinter"

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Razorpay Client Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Sentry (Optional for frontend monitoring)
NEXT_PUBLIC_SENTRY_DSN=""


# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (NEVER expose via NEXT_PUBLIC_* or to the browser)
# ------------------------------------------------------------------------------

# Supabase Admin/Service Role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Transaction Pooler or direct connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_printer"

# ------------------------------------------------------------------------------
# BACKBLAZE B2 — Document File Storage
# ------------------------------------------------------------------------------
# The actual uploaded files (PDFs, DOCX, etc.) are stored in Backblaze B2.
# Supabase remains the database and authentication layer.
#
# These are SERVER-ONLY secrets. NEVER use NEXT_PUBLIC_ for B2 credentials.
# NEVER commit real credentials to source control.
#
# How to obtain:
#   1. Log in to https://secure.backblaze.com/
#   2. Go to App Keys → Add a New Application Key
#   3. Restrict the key to your bucket (yourprinter-documents-2026)
#   4. Copy the keyID and applicationKey immediately (shown once only)
#
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET_NAME="yourprinter-documents-2026"
B2_KEY_ID=""
B2_APPLICATION_KEY=""

# ------------------------------------------------------------------------------
# RAZORPAY SERVER CREDENTIALS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ------------------------------------------------------------------------------
# UPSTASH REDIS (For Rate Limiting)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ------------------------------------------------------------------------------
# INNGEST (Background Jobs)
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"
